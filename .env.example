# Marketing Video Bot -- Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Google API key (Gemini script generation + Gemini TTS) ───────────────────
# Used by GeminiScriptGenerator (gemini-2.5-flash) and GeminiTTSProvider
# (gemini-2.5-flash-preview-tts). One key covers both.
# If unset, the pipeline falls back to TemplateScriptGenerator for scripts
# and FliteLocalTTSProvider for voiceover -- fully offline, no API needed.
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ── ElevenLabs API (fallback neural TTS if Gemini TTS fails) ─────────────────
# Optional. If set, ElevenLabs is tried after Gemini TTS and before flite.
# Get your key at https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ── Worker configuration ──────────────────────────────────────────────────────
# Number of parallel video-rendering worker threads.
# Default: 2
VIDEO_BOT_WORKERS=2

# ── Flask secret key ──────────────────────────────────────────────────────────
# Use a long random string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret
